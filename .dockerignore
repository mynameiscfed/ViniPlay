# Exclude everything the running app doesn't need from the build context.
# Smaller context = faster uploads to the builder and fewer cache invalidations
# of the final `COPY . .` layer.

# Node.js (dependencies are installed inside the image)
node_modules
npm-debug.log

# Environment variables
.env
.env.*

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# Persistent data directories (should be mounted as volumes, not copied)
viniplay-data
viniplay-dvr

# Docs and README screenshots (~60 MB of GIFs)
*.md
images

# CI, tests and git metadata
.git
.gitignore
.github
test
docker-image.yml

# Editor / OS clutter
.vscode
.idea
*.swp
.DS_Store
