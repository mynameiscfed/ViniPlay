# Environment variables for ViniPlay.
# Copy this file to .env and edit it there. .env is ignored by git; this example is not.
#
# A long, random, secret string used to sign the session ID cookie. Generate one with:
#   openssl rand -hex 32
# If this is empty or still the placeholder below, ViniPlay generates a random secret and
# stores it in /data/session-secret (mode 0600), so a default install is still safe.
SESSION_SECRET=replace_this_with_a_very_long_random_and_secret_string

# Add a contact email for VAPID push notifications.
# This is required by push services. It should start with "mailto:".
VAPID_CONTACT_EMAIL=mailto:your_email@example.com

# Optional: UID/GID the app runs as inside the container (default 1000:1000).
# Set these to the owner of your host viniplay-data / viniplay-dvr folders.
# PUID=1000
# PGID=1000

# Optional: let the image proxy and URL validator reach hosts on your LAN.
# SSRF_ALLOW_PRIVATE_NETWORKS=true
# SSRF_ALLOWED_HOSTS=dispatcharr.lan,192.168.1.20

# Optional: SQLite journal mode. The default (WAL) is fastest. Use DELETE if /data is on NFS/SMB.
# SQLITE_JOURNAL_MODE=DELETE
