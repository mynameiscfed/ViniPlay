{
  "name": "viniplay",
  "version": "1.0.0",
  "description": "A simple IPTV player with server-side storage and user authentication.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:container": "bash test/container-smoke.sh",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/css/tailwind.css --watch"
  },
  "author": "Andrea Ardovini",
  "license": "CC BY-NC-SA 4.0",
  "dependencies": {
    "axios": "^1.7.2",
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "bcrypt": "^6.0.0",
    "express-session": "^1.18.2",
    "sqlite3": "^5.1.7",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.5",
    "xml-js": "^1.6.11",
    "web-push": "^3.6.7",
    "node-schedule": "^2.1.1",
    "diskusage": "^1.2.0",
    "systeminformation": "^5.27.11"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
